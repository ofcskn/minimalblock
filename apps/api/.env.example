# Supabase — find these in your project dashboard under Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # the SECRET key, not the publishable anon key

# Google Gemini — obtain from https://aistudio.google.com → Get API key
GEMINI_API_KEY=your-gemini-api-key

# Optional
API_PORT=8787
CORS_ORIGIN=http://localhost:4200

# Trendyol Seller API (get from Trendyol Seller Center → Integration → API)
# Set TRENDYOL_MOCK=false to use real credentials, true for fixture/demo data
TRENDYOL_MERCHANT_ID=your-merchant-id
TRENDYOL_API_KEY=your-api-key
TRENDYOL_API_SECRET=your-api-secret
TRENDYOL_MOCK=false
