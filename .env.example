# Web app — Supabase (find these in your project dashboard under Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web app — API base URL (points to apps/api)
VITE_API_BASE_URL=http://localhost:8787

# API server — Trendyol Seller API (get from Trendyol Seller Center → Integration → API)
# Leave empty or set TRENDYOL_MOCK=true to run with fixture data (demo mode)
TRENDYOL_SELLER_ID=your-seller-id
TRENDYOL_API_KEY=your-api-key
TRENDYOL_API_SECRET=your-api-secret
TRENDYOL_MOCK=true